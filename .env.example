# Copy to .env for local development. On AWS these are set as Lambda / AgentCore
# environment variables and secrets (see infra/template.yaml).

AWS_REGION=us-west-2

# Bedrock model for the category reasoning agents (Amazon Nova Lite).
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# DynamoDB single table.
TABLE_NAME=HouseholdAgent

# Bedrock AgentCore Memory resource id (create with scripts/create_memory.py).
AGENTCORE_MEMORY_ID=

# SES — verified sender + the family's inbox that approval emails go to.
SES_SENDER=household-agent@example.com
APPROVAL_RECIPIENT=you@example.com

# Public base URL of the approve/reject/admin API (API Gateway stage URL).
# Only knowable after the first deploy; used to build links in the email body.
BASE_URL=http://localhost:8080

# Gate on the sweep entrypoint (shared secret; real cost + real emails per call).
SWEEP_SECRET=change-me

# HTTP Basic Auth for GET /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Live current prices (flights / shopping). Historical trend is seeded synthetic
# data — see scripts/seed_data.py.
SERPAPI_API_KEY=
